@model InvoiceFormViewModel
@{
    ViewData["Title"] = "Edit Invoice";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Edit Invoice</h1>
        <p class="page-subtitle">Update invoice @Model.InvoiceNumber</p>
    </div>
</div>

<div class="form-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />

        <partial name="_InvoiceForm" model="Model" />

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-accent">Save Changes</button>
            <a asp-action="Index" class="btn btn-soft">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
