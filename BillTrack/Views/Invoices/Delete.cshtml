@model Invoice
@{
    ViewData["Title"] = "Delete Invoice";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Delete Invoice</h1>
        <p class="page-subtitle">This action cannot be undone</p>
    </div>
</div>

<div class="form-card">
    <div class="alert alert-danger">Are you sure you want to delete this invoice?</div>

    <div class="row detail-list">
        <div class="col-md-6">
            <div class="detail-label">Invoice</div>
            <div class="detail-value">@Model.InvoiceNumber</div>
        </div>
        <div class="col-md-6">
            <div class="detail-label">Client</div>
            <div class="detail-value">@Model.Client?.FullName</div>
        </div>
        <div class="col-md-6">
            <div class="detail-label">Amount</div>
            <div class="detail-value">@Model.Amount.ToMoney()</div>
        </div>
        <div class="col-md-6">
            <div class="detail-label">Status</div>
            <div class="detail-value"><partial name="_StatusBadge" model="Model.EffectiveStatus" /></div>
        </div>
    </div>

    <form asp-action="Delete" method="post" class="d-flex gap-2 mt-3">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger-solid">Delete</button>
        <a asp-action="Index" class="btn btn-soft">Cancel</a>
    </form>
</div>
