@model Client
@{
    ViewData["Title"] = "Delete Client";
    var hasInvoices = Model.Invoices.Any();
}

<div class="page-header">
    <div>
        <h1 class="page-title">Delete Client</h1>
        <p class="page-subtitle">This action cannot be undone</p>
    </div>
</div>

<div class="form-card">
    @if (hasInvoices)
    {
        <div class="alert alert-warning">
            This client has @Model.Invoices.Count invoice(s) and cannot be deleted.
        </div>
    }
    else
    {
        <div class="alert alert-danger">Are you sure you want to delete this client?</div>
    }

    <div class="row detail-list">
        <div class="col-md-6">
            <div class="detail-label">Full Name</div>
            <div class="detail-value">@Model.FullName</div>
        </div>
        <div class="col-md-6">
            <div class="detail-label">Email</div>
            <div class="detail-value">@Model.Email</div>
        </div>
    </div>

    <form asp-action="Delete" method="post" class="d-flex gap-2 mt-3">
        <input type="hidden" asp-for="Id" />
        @if (!hasInvoices)
        {
            <button type="submit" class="btn btn-danger-solid">Delete</button>
        }
        <a asp-action="Index" class="btn btn-soft">Back to list</a>
    </form>
</div>
